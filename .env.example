# Copy to .env (never commit it). Every variable the engine and CLI read.

# --- database ---
# owner/superuser connection for `rpx db migrate`, `rpx ws create`, imports
DATABASE_URL=
# runtime connection (role rpx_engine in production); falls back to DATABASE_URL
RPX_DATABASE_URL=
RPX_POOL_MAX=10

# --- engine ---
# >= 32 random characters, e.g. `openssl rand -hex 32`. Rotating it invalidates open forms/links.
RPX_SECRET=
PORT=8080
HOST=0.0.0.0
# set to 1 behind HTTPS (Cloudflare Tunnel) so session cookies get the Secure flag
RPX_SECURE_COOKIES=
# public base URL users see, used for the OIDC redirect URI, e.g. https://apps.kcsi.example
RPX_PUBLIC_URL=
# login / SSO attempts per IP per minute (default 20)
RPX_LOGIN_RATE_LIMIT=

# --- SSO (OIDC) ---
# one variable per app that uses `authentication: { scheme: oidc }`; the spec names it in client_secret_env
RPX_OIDC_SECRET_KCSI=

# --- tests only ---
TEST_DATABASE_URL=
