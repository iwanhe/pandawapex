{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/iwanhe/pandawapex/spec.schema.json",
  "title": "pandawapex application spec (v0, Fase 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app",
    "name",
    "parsing_schema",
    "pages"
  ],
  "definitions": {
    "itemName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,59}$"
    },
    "ident": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*(\\.[A-Za-z_][A-Za-z0-9_$]*)?$"
    },
    "colSpan": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]{0,59}$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "clear_cache": {
          "type": "string",
          "pattern": "^[0-9]+(,[0-9]+)*$"
        }
      }
    },
    "lov": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "static": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "display",
              "return"
            ],
            "properties": {
              "display": {
                "type": "string"
              },
              "return": {
                "type": "string"
              }
            }
          }
        },
        "sql": {
          "type": "string",
          "description": "select display_value, return_value from ..."
        },
        "null_display": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "static"
          ]
        },
        {
          "required": [
            "sql"
          ]
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/itemName"
        },
        "type": {
          "enum": [
            "text",
            "number",
            "textarea",
            "date",
            "datetime",
            "select",
            "popup_lov",
            "radio",
            "checkbox",
            "checkbox_group",
            "switch",
            "hidden",
            "display_only",
            "password"
          ]
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "col_span": {
          "$ref": "#/definitions/colSpan"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column"
          ],
          "properties": {
            "column": {
              "$ref": "#/definitions/ident"
            },
            "pk": {
              "type": "boolean"
            }
          }
        },
        "default": {
          "type": "string"
        },
        "lov": {
          "oneOf": [
            {
              "$ref": "#/definitions/lov"
            },
            {
              "$ref": "#/definitions/lovName"
            }
          ]
        },
        "protection": {
          "enum": [
            "unrestricted",
            "checksum_session",
            "restricted"
          ]
        },
        "max_length": {
          "type": "integer",
          "minimum": 1
        },
        "authorization": {
          "$ref": "#/definitions/authzRef"
        },
        "condition": {
          "$ref": "#/definitions/condition"
        },
        "cascade": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/itemName"
          },
          "description": "parent items: when one changes, this item's list of values is reloaded and its value cleared"
        },
        "null_display": {
          "type": "string",
          "description": "text of the empty choice (select / popup LOV); overrides lov.null_display"
        },
        "on_value": {
          "type": "string",
          "description": "checkbox / switch: value when on (default Y)"
        },
        "off_value": {
          "type": "string",
          "description": "checkbox / switch: value when off (default N)"
        },
        "inline": {
          "type": "boolean",
          "description": "radio / checkbox group: options side by side"
        },
        "format": {
          "enum": [
            "number",
            "integer",
            "date",
            "datetime"
          ],
          "description": "display_only: how the value is shown"
        }
      }
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,59}$"
        },
        "label": {
          "type": "string"
        },
        "hot": {
          "type": "boolean"
        },
        "action": {
          "enum": [
            "submit",
            "redirect",
            "close_dialog"
          ]
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "style": {
          "enum": [
            "normal",
            "danger",
            "ghost"
          ]
        },
        "confirm": {
          "type": "string"
        },
        "position": {
          "enum": [
            "next",
            "previous",
            "header"
          ]
        },
        "condition": {
          "$ref": "#/definitions/condition"
        },
        "authorization": {
          "$ref": "#/definitions/authzRef"
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "data_type": {
          "enum": [
            "text",
            "number",
            "date",
            "timestamp",
            "boolean"
          ]
        },
        "is_pk": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "link": {
          "$ref": "#/definitions/target"
        },
        "searchable": {
          "type": "boolean"
        },
        "sortable": {
          "type": "boolean"
        },
        "format": {
          "enum": [
            "number",
            "integer",
            "date"
          ],
          "description": "display only: number = id-ID grouping, up to 2 decimals; integer; date = DD-MM-YYYY"
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static_id",
        "type"
      ],
      "properties": {
        "static_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,59}$"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "enum": [
            "static",
            "classic_report",
            "form",
            "interactive_report"
          ]
        },
        "template": {
          "enum": [
            "standard",
            "plain",
            "collapsible"
          ]
        },
        "col_span": {
          "$ref": "#/definitions/colSpan"
        },
        "new_row": {
          "type": "boolean"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sql": {
              "type": "string"
            },
            "table": {
              "$ref": "#/definitions/ident"
            },
            "html": {
              "type": "string"
            }
          }
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "empty_text": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/column"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/item"
          }
        },
        "buttons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/button"
          }
        },
        "condition": {
          "$ref": "#/definitions/condition"
        },
        "authorization": {
          "$ref": "#/definitions/authzRef"
        },
        "max_download_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "not_null",
            "sql_expression",
            "sql_exists",
            "sql_not_exists",
            "regex",
            "fn_boolean",
            "fn_returns_error",
            "is_numeric",
            "is_date",
            "is_timestamp"
          ]
        },
        "expression": {
          "type": "string",
          "description": "sql_*: SQL; regex: pattern; fn_boolean: PL/pgSQL function body returning boolean (true = valid); fn_returns_error: function body returning the error text, or null when valid"
        },
        "error_msg": {
          "type": "string"
        },
        "item": {
          "$ref": "#/definitions/itemName"
        },
        "when_button": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/definitions/condition"
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "point": {
          "enum": [
            "before_header",
            "after_submit"
          ]
        },
        "type": {
          "enum": [
            "form_init",
            "form_dml",
            "plpgsql",
            "clear_cache",
            "close_dialog"
          ]
        },
        "region": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "when_button": {
          "type": "string"
        },
        "success_msg": {
          "type": "string"
        },
        "error_msg": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/definitions/condition"
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "clear_cache": {
          "type": "string",
          "pattern": "^[0-9]+(,[0-9]+)*$"
        },
        "when_button": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/definitions/condition"
        }
      }
    },
    "navEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "page": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/navEntry"
          }
        },
        "authorization": {
          "$ref": "#/definitions/authzRef"
        },
        "condition": {
          "$ref": "#/definitions/condition"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "description": "render / run only when this holds",
      "properties": {
        "item_not_null": {
          "$ref": "#/definitions/itemName"
        },
        "item_null": {
          "$ref": "#/definitions/itemName"
        },
        "item_equals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "value"
          ],
          "properties": {
            "item": {
              "$ref": "#/definitions/itemName"
            },
            "value": {
              "type": "string"
            }
          }
        },
        "request_equals": {
          "type": "string"
        },
        "sql_expression": {
          "type": "string"
        },
        "sql_exists": {
          "type": "string"
        },
        "never": {
          "const": true
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "client_id",
        "client_secret_env"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^https?://"
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "client_secret_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "name of the environment variable holding the client secret (never the secret itself)"
        },
        "scopes": {
          "type": "string"
        },
        "username_claim": {
          "type": "string"
        },
        "groups_claim": {
          "type": "string"
        },
        "allowed_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          }
        },
        "provision": {
          "type": "boolean"
        },
        "button_label": {
          "type": "string"
        }
      }
    },
    "authzRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,59}$"
    },
    "authzScheme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "source"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/authzRef"
        },
        "type": {
          "enum": [
            "group_member",
            "exists_sql",
            "not_exists_sql",
            "fn_boolean"
          ]
        },
        "source": {
          "type": "string",
          "description": "group_member: group name(s), comma separated; *_sql: query; fn_boolean: PL/pgSQL body returning boolean"
        },
        "evaluation": {
          "enum": [
            "once_per_session",
            "once_per_page_view",
            "always"
          ]
        },
        "error_msg": {
          "type": "string"
        }
      }
    },
    "computation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "type",
        "expression"
      ],
      "properties": {
        "item": {
          "$ref": "#/definitions/itemName"
        },
        "point": {
          "enum": [
            "before_header",
            "after_submit",
            "on_new_session",
            "after_authentication"
          ]
        },
        "type": {
          "enum": [
            "static",
            "item",
            "sql_query",
            "sql_expression",
            "plpgsql_fn"
          ]
        },
        "expression": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/definitions/condition"
        }
      }
    },
    "lovName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,59}$",
      "description": "name of a shared list of values (top-level lovs)"
    }
  },
  "properties": {
    "app": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,59}$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "parsing_schema": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$"
    },
    "home_page": {
      "type": "integer",
      "minimum": 0
    },
    "timezone": {
      "type": "string"
    },
    "substitutions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "authentication": {
      "oneOf": [
        {
          "enum": [
            "builtin_accounts",
            "no_auth"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme"
          ],
          "properties": {
            "scheme": {
              "enum": [
                "builtin_accounts",
                "oidc",
                "no_auth"
              ]
            },
            "oidc": {
              "$ref": "#/definitions/oidc"
            },
            "allow_builtin": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "navigation": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/navEntry"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "name"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          },
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,59}$"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "requires_auth": {
            "type": "boolean"
          },
          "breadcrumb_parent": {
            "type": "integer"
          },
          "regions": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/region"
            }
          },
          "validations": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/validation"
            }
          },
          "processes": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/process"
            }
          },
          "branches": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/branch"
            }
          },
          "authorization": {
            "$ref": "#/definitions/authzRef"
          },
          "computations": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/computation"
            }
          },
          "mode": {
            "enum": [
              "normal",
              "modal"
            ],
            "description": "modal: opens in a dialog over the calling page"
          },
          "dialog_size": {
            "enum": [
              "sm",
              "md",
              "lg"
            ]
          }
        }
      }
    },
    "authorization": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/authzScheme"
      }
    },
    "authorization_scheme": {
      "$ref": "#/definitions/authzRef"
    },
    "application_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/definitions/itemName"
          },
          "protection": {
            "enum": [
              "unrestricted",
              "checksum_session",
              "restricted"
            ]
          }
        }
      }
    },
    "computations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/computation"
      }
    },
    "lovs": {
      "type": "object",
      "description": "shared lists of values, referenced by name from item.lov",
      "propertyNames": {
        "$ref": "#/definitions/lovName"
      },
      "additionalProperties": {
        "$ref": "#/definitions/lov"
      }
    }
  }
}
