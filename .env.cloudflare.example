# Append these settings to your local .env file. Never commit the real token.
# Create a remotely-managed tunnel in Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# Dedicated runtime connection. Do not use the postgres superuser for the app service.
# Example format: postgres://rpx_engine:<URL-ENCODED-PASSWORD>@db:5432/rpx
RPX_DATABASE_URL=

# Public URL used by PANDAWA APEX for redirects / OIDC callback construction.
RPX_PUBLIC_URL=https://demo.domain-anda.com
RPX_SECURE_COOKIES=1
