# Tambahkan ke file .env (bukan file ini). Jangan pernah commit nilai aslinya.
# Panduan: docs/cloudflare-local-demo.md

# Token tunnel dari Cloudflare dashboard > Networking > Tunnels (tunnel yang dikelola dari dashboard)
CLOUDFLARE_TUNNEL_TOKEN=

# Kata sandi role rpx_engine yang dipakai engine (bukan superuser postgres).
# Huruf/angka saja agar aman di URL koneksi, minimal 16 karakter: openssl rand -hex 24
RPX_ENGINE_PASSWORD=

# Alamat publik aplikasi (dipakai untuk redirect dan callback SSO)
RPX_PUBLIC_URL=https://demo.domain-anda.com

# Hostname yang boleh membuka builder (/builder), dilindungi Cloudflare Access. "none" = builder mati.
RPX_BUILDER_HOSTS=builder.domain-anda.com
